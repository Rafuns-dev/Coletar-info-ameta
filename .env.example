# Configurações públicas do projeto Firebase (obtidas no Console do Firebase -> Configurações do projeto)
VITE_FIREBASE_API_KEY="SUA_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="SEU_SENDER_ID"
VITE_FIREBASE_APP_ID="SEU_APP_ID"

# ID do banco Firestore (use "(default)" no banco padrão do Firebase ou o ID específico do banco)
VITE_FIREBASE_DATABASE_ID="(default)"

# Chave pública do reCAPTCHA v3 para Firebase App Check (opcional em desenvolvimento local)
VITE_RECAPTCHA_SITE_KEY=""
