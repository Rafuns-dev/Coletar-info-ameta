rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rede de segurança padrão: negar tudo que não for explicitamente liberado
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== PRIMITIVAS GLOBAIS ====================

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function txt(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function temPerfil() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function equipe() {
      return temPerfil()
        && perfil().ativo == true
        && perfil().role in ['admin', 'operador'];
    }

    function isAdmin() {
      return temPerfil()
        && perfil().ativo == true
        && perfil().role == 'admin';
    }

    // ==================== VALIDAÇÕES DE ESQUEMA ====================

    function isValidCpfFormat(cpf) {
      return cpf is string
        && cpf.size() == 14
        && cpf.matches('^[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}$')
        && !cpf.matches('^(0{3}\\.0{3}\\.0{3}-0{2}|1{3}\\.1{3}\\.1{3}-1{2}|2{3}\\.2{3}\\.2{3}-2{2}|3{3}\\.3{3}\\.3{3}-3{2}|4{3}\\.4{3}\\.4{3}-4{2}|5{3}\\.5{3}\\.5{3}-5{2}|6{3}\\.6{3}\\.6{3}-6{2}|7{3}\\.7{3}\\.7{3}-7{2}|8{3}\\.8{3}\\.8{3}-8{2}|9{3}\\.9{3}\\.9{3}-9{2})$');
    }

    function isValidCnpjFormat(cnpj) {
      return cnpj is string
        && cnpj.size() == 18
        && cnpj.matches('^[0-9]{2}\\.[0-9]{3}\\.[0-9]{3}/[0-9]{4}-[0-9]{2}$')
        && !cnpj.matches('^(0{2}\\.0{3}\\.0{3}/0{4}-0{2}|1{2}\\.1{3}\\.1{3}/1{4}-1{2}|2{2}\\.2{3}\\.2{3}/2{4}-2{2}|3{2}\\.3{3}\\.3{3}/3{4}-3{2}|4{2}\\.4{3}\\.4{3}/4{4}-4{2}|5{2}\\.5{3}\\.5{3}/5{4}-5{2}|6{2}\\.6{3}\\.6{3}/6{4}-6{2}|7{2}\\.7{3}\\.7{3}/7{4}-7{2}|8{2}\\.8{3}\\.8{3}/8{4}-8{2}|9{2}\\.9{3}\\.9{3}/9{4}-9{2})$');
    }

    function isValidCadastro(data) {
      return data.keys().hasAll([
        'dataCadastro',
        'funcao',
        'nomeCompleto',
        'cpf',
        'rg',
        'naturalidade',
        'nacionalidade',
        'estadoCivil',
        'dataNascimento',
        'cnpj',
        'enderecoEmpresa',
        'cepEmpresa',
        'nomePai',
        'nomeMae',
        'email',
        'telefone',
        'status',
        'observacoes',
        'visto',
        'vistoEm',
        'criadoEm',
        'atualizadoEm'
      ])
      && data.keys().hasOnly([
        'dataCadastro',
        'funcao',
        'nomeCompleto',
        'cpf',
        'rg',
        'naturalidade',
        'nacionalidade',
        'estadoCivil',
        'dataNascimento',
        'cnpj',
        'enderecoEmpresa',
        'cepEmpresa',
        'nomePai',
        'nomeMae',
        'email',
        'telefone',
        'status',
        'observacoes',
        'visto',
        'vistoEm',
        'criadoEm',
        'atualizadoEm',
        'nomeCompletoLower',
        'cpfDigitos',
        'cnpjDigitos',
        'telefoneDigitos',
        'cepDigitos'
      ])
      && txt(data.dataCadastro, 10, 10)
      && data.dataCadastro.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && data.funcao is string
      && data.funcao in [
        'Analista de documentação',
        'Técnico de Instalação',
        'Técnico de Vistoria'
      ]
      && txt(data.nomeCompleto, 3, 150)
      && isValidCpfFormat(data.cpf)
      && txt(data.rg, 5, 30)
      && txt(data.naturalidade, 2, 120)
      && txt(data.nacionalidade, 2, 80)
      && data.estadoCivil is string
      && data.estadoCivil in [
        'Solteiro(a)',
        'Casado(a)',
        'União Estável',
        'Divorciado(a)',
        'Separado(a)',
        'Viúvo(a)'
      ]
      && txt(data.dataNascimento, 10, 10)
      && data.dataNascimento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && isValidCnpjFormat(data.cnpj)
      && txt(data.enderecoEmpresa, 5, 250)
      && txt(data.cepEmpresa, 9, 9)
      && data.cepEmpresa.matches('^[0-9]{5}-[0-9]{3}$')
      && txt(data.nomePai, 3, 150)
      && txt(data.nomeMae, 3, 150)
      && txt(data.email, 5, 160)
      && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
      && txt(data.telefone, 14, 15)
      && data.telefone.matches('^\\([0-9]{2}\\) [0-9]{4,5}-[0-9]{4}$')
      && data.status is string
      && data.status in ['Novo', 'Em análise', 'Dados conferidos', 'Concluído']
      && txt(data.observacoes, 0, 4000)
      && data.visto is bool
      && (data.vistoEm == null || data.vistoEm is timestamp)
      && data.criadoEm is timestamp
      && data.atualizadoEm is timestamp
      && (!('nomeCompletoLower' in data) || txt(data.nomeCompletoLower, 3, 150))
      && (!('cpfDigitos' in data) || (txt(data.cpfDigitos, 11, 11) && data.cpfDigitos.matches('^[0-9]{11}$')))
      && (!('cnpjDigitos' in data) || (txt(data.cnpjDigitos, 14, 14) && data.cnpjDigitos.matches('^[0-9]{14}$')))
      && (!('telefoneDigitos' in data) || (txt(data.telefoneDigitos, 10, 11) && data.telefoneDigitos.matches('^[0-9]{10,11}$')))
      && (!('cepDigitos' in data) || (txt(data.cepDigitos, 8, 8) && data.cepDigitos.matches('^[0-9]{8}$')));
    }

    function hasNormalizedCadastroFields(data) {
      return data.keys().hasAll([
        'nomeCompletoLower',
        'cpfDigitos',
        'cnpjDigitos',
        'telefoneDigitos',
        'cepDigitos'
      ]);
    }

    function isValidCadastroChave(data, chaveId) {
      return data.keys().hasAll(['tipo', 'valorDigitos', 'cadastroId', 'criadoEm'])
        && data.keys().hasOnly(['tipo', 'valorDigitos', 'cadastroId', 'criadoEm'])
        && data.tipo is string
        && data.tipo in ['cpf', 'cnpj']
        && data.valorDigitos is string
        && (
          (data.tipo == 'cpf' && data.valorDigitos.size() == 11 && data.valorDigitos.matches('^[0-9]{11}$') && chaveId == 'cpf_' + data.valorDigitos)
          || (data.tipo == 'cnpj' && data.valorDigitos.size() == 14 && data.valorDigitos.matches('^[0-9]{14}$') && chaveId == 'cnpj_' + data.valorDigitos)
        )
        && isValidId(data.cadastroId)
        && data.criadoEm is timestamp;
    }

    function isValidDocumentoAnexo(data, docTipo) {
      return data.keys().hasAll([
        'tipo',
        'nomeArquivo',
        'mimeType',
        'tamanhoBytes',
        'conteudoBase64',
        'criadoEm',
        'atualizadoEm'
      ])
      && data.keys().hasOnly([
        'tipo',
        'nomeArquivo',
        'mimeType',
        'tamanhoBytes',
        'conteudoBase64',
        'criadoEm',
        'atualizadoEm'
      ])
      && data.tipo is string
      && data.tipo == docTipo
      && data.tipo in ['rg', 'cnh', 'certificado_mei']
      && txt(data.nomeArquivo, 1, 200)
      && data.mimeType is string
      && data.mimeType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp']
      && data.tamanhoBytes is int
      && data.tamanhoBytes >= 1
      && data.tamanhoBytes <= 700000
      && txt(data.conteudoBase64, 4, 950000)
      && data.criadoEm is timestamp
      && data.atualizadoEm is timestamp;
    }

    function isValidCamposTemplate(campos) {
      return campos is map
        && campos.keys().hasAll([
          'CONTRATADA_RAZAO_SOCIAL',
          'CONTRATADA_CNPJ',
          'CONTRATADA_ENDERECO',
          'VALOR_TOTAL',
          'VALOR_EXTENSO',
          'MARCA_INTEGRAL',
          'MARCA_PARCELADO',
          'NUM_PARCELAS',
          'NUM_PARCELAS_EXTENSO',
          'VALOR_PARCELA',
          'MES_ANO_INICIO',
          'LOCAL_DATA'
        ])
        && campos.keys().hasOnly([
          'CONTRATADA_RAZAO_SOCIAL',
          'CONTRATADA_CNPJ',
          'CONTRATADA_ENDERECO',
          'VALOR_TOTAL',
          'VALOR_EXTENSO',
          'MARCA_INTEGRAL',
          'MARCA_PARCELADO',
          'NUM_PARCELAS',
          'NUM_PARCELAS_EXTENSO',
          'VALOR_PARCELA',
          'MES_ANO_INICIO',
          'LOCAL_DATA'
        ])
        && txt(campos.CONTRATADA_RAZAO_SOCIAL, 0, 250)
        && txt(campos.CONTRATADA_CNPJ, 0, 40)
        && txt(campos.CONTRATADA_ENDERECO, 0, 350)
        && txt(campos.VALOR_TOTAL, 0, 60)
        && txt(campos.VALOR_EXTENSO, 0, 300)
        && txt(campos.MARCA_INTEGRAL, 0, 10)
        && txt(campos.MARCA_PARCELADO, 0, 10)
        && txt(campos.NUM_PARCELAS, 0, 30)
        && txt(campos.NUM_PARCELAS_EXTENSO, 0, 120)
        && txt(campos.VALOR_PARCELA, 0, 60)
        && txt(campos.MES_ANO_INICIO, 0, 60)
        && txt(campos.LOCAL_DATA, 0, 180);
    }

    function isValidTermo(data) {
      return data.keys().hasAll([
        'cadastroId',
        'razaoSocialContratada',
        'cnpjContratada',
        'valorTotal',
        'formaAbatimento',
        'numParcelas',
        'valorParcela',
        'mesAnoInicio',
        'localData',
        'documentosSelecionados',
        'camposTemplate',
        'formatoInicial',
        'geradoPorUid',
        'geradoPorNome',
        'geradoPorEmail',
        'criadoEm'
      ])
      && data.keys().hasOnly([
        'cadastroId',
        'razaoSocialContratada',
        'cnpjContratada',
        'valorTotal',
        'formaAbatimento',
        'numParcelas',
        'valorParcela',
        'mesAnoInicio',
        'localData',
        'documentosSelecionados',
        'camposTemplate',
        'formatoInicial',
        'geradoPorUid',
        'geradoPorNome',
        'geradoPorEmail',
        'criadoEm'
      ])
      && isValidId(data.cadastroId)
      && txt(data.razaoSocialContratada, 0, 250)
      && txt(data.cnpjContratada, 0, 40)
      && txt(data.valorTotal, 0, 40)
      && data.formaAbatimento is string && data.formaAbatimento in ['integral', 'parcelado', 'blank']
      && txt(data.numParcelas, 0, 20)
      && txt(data.valorParcela, 0, 40)
      && txt(data.mesAnoInicio, 0, 40)
      && txt(data.localData, 0, 180)
      && data.documentosSelecionados is list
      && data.documentosSelecionados.size() >= 1
      && data.documentosSelecionados.size() <= 40
      && data.documentosSelecionados[0] is string
      && data.documentosSelecionados[0].size() >= 1
      && data.documentosSelecionados[0].size() <= 300
      && isValidCamposTemplate(data.camposTemplate)
      && data.formatoInicial is string && data.formatoInicial in ['docx', 'pdf']
      && isValidId(data.geradoPorUid)
      && txt(data.geradoPorNome, 1, 150)
      && txt(data.geradoPorEmail, 3, 160)
      && data.criadoEm is timestamp;
    }

    function isValidUsuario(data) {
      return data.keys().hasAll([
        'nome',
        'email',
        'role',
        'ativo',
        'criadoEm'
      ])
      && data.keys().hasOnly([
        'nome',
        'email',
        'role',
        'ativo',
        'criadoEm',
        'atualizadoEm'
      ])
      && txt(data.nome, 2, 150)
      && txt(data.email, 5, 160)
      && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
      && data.role is string && data.role in ['admin', 'operador']
      && data.ativo is bool
      && data.criadoEm is timestamp
      && (!('atualizadoEm' in data) || data.atualizadoEm is timestamp);
    }

    function isValidAuditoriaDetalhes(detalhes) {
      return detalhes is map
        && detalhes.keys().hasOnly([
          'formato',
          'valorTotal',
          'formaAbatimento',
          'razaoSocial',
          'statusAnterior',
          'statusNovo',
          'termoId',
          'resumo'
        ])
        && (!('formato' in detalhes) || txt(detalhes.formato, 0, 20))
        && (!('valorTotal' in detalhes) || txt(detalhes.valorTotal, 0, 40))
        && (!('formaAbatimento' in detalhes) || txt(detalhes.formaAbatimento, 0, 30))
        && (!('razaoSocial' in detalhes) || txt(detalhes.razaoSocial, 0, 250))
        && (!('statusAnterior' in detalhes) || txt(detalhes.statusAnterior, 0, 40))
        && (!('statusNovo' in detalhes) || txt(detalhes.statusNovo, 0, 40))
        && (!('termoId' in detalhes) || txt(detalhes.termoId, 0, 128))
        && (!('resumo' in detalhes) || txt(detalhes.resumo, 0, 400));
    }

    function isValidAuditoria(data) {
      return data.keys().hasAll([
        'acao',
        'entidade',
        'entidadeId',
        'cadastroId',
        'uid',
        'nome',
        'email',
        'detalhes',
        'criadoEm'
      ])
      && data.keys().hasOnly([
        'acao',
        'entidade',
        'entidadeId',
        'cadastroId',
        'uid',
        'nome',
        'email',
        'detalhes',
        'criadoEm'
      ])
      && data.acao is string
      && data.acao in [
        'LOGIN',
        'LOGOUT',
        'LOGOUT_INATIVIDADE',
        'ABRIU_CADASTRO',
        'EDITOU_CADASTRO',
        'ALTEROU_STATUS',
        'SALVOU_OBSERVACOES',
        'EXCLUIU_CADASTRO',
        'GEROU_TERMO_DOCX',
        'GEROU_TERMO_PDF',
        'REBAIXOU_TERMO_DOCX',
        'REBAIXOU_TERMO_PDF',
        'CRIOU_USUARIO',
        'ATUALIZOU_USUARIO',
        'REMOVEU_USUARIO',
        'ANEXOU_DOCUMENTO',
        'EXCLUIU_DOCUMENTO'
      ]
      && data.entidade is string
      && data.entidade in ['sessao', 'cadastros', 'termos', 'usuarios']
      && isValidId(data.entidadeId)
      && txt(data.cadastroId, 0, 128)
      && isValidId(data.uid)
      && txt(data.nome, 1, 150)
      && txt(data.email, 3, 160)
      && isValidAuditoriaDetalhes(data.detalhes)
      && data.criadoEm is timestamp;
    }

    // ==================== REGRAS DAS COLEÇÕES ====================

    // CADASTROS (formulário público)
    match /cadastros/{cadastroId} {
      // Visitante sem login: SOMENTE criar com os 16 campos exatos, campos normalizados, estado inicial fixo
      // e criação atômica das chaves únicas de CPF e CNPJ (bloqueia duplicidade no banco)
      allow create: if isValidId(cadastroId)
        && isValidCadastro(incoming())
        && hasNormalizedCadastroFields(incoming())
        && incoming().status == 'Novo'
        && incoming().observacoes == ''
        && incoming().visto == false
        && incoming().vistoEm == null
        && incoming().criadoEm == request.time
        && incoming().atualizadoEm == request.time
        && existsAfter(/databases/$(database)/documents/cadastros_chaves/$('cpf_' + incoming().cpfDigitos))
        && existsAfter(/databases/$(database)/documents/cadastros_chaves/$('cnpj_' + incoming().cnpjDigitos));

      // Somente a equipe com perfil ativo lê
      allow get, list: if equipe();

      // Equipe atualiza: operador só status/observações/visto; admin pode tudo
      allow update: if equipe()
        && isValidId(cadastroId)
        && isValidCadastro(incoming())
        && incoming().criadoEm == existing().criadoEm
        && incoming().atualizadoEm == request.time
        && (
          isAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'status',
            'observacoes',
            'visto',
            'vistoEm',
            'atualizadoEm'
          ])
        );

      // Só administrador exclui
      allow delete: if isAdmin() && isValidId(cadastroId);

      // DOCUMENTOS OPCIONAIS ANEXADOS (RG, CNH, Certificado MEI)
      match /documentos/{docTipo} {
        allow get: if equipe()
          && isValidId(cadastroId)
          && docTipo in ['rg', 'cnh', 'certificado_mei'];

        allow list: if equipe();

        // Visitante sem login: apenas na criação atômica do cadastro correspondente
        // Equipe autenticada: pode anexar em cadastro existente
        allow create: if isValidId(cadastroId)
          && docTipo in ['rg', 'cnh', 'certificado_mei']
          && isValidDocumentoAnexo(incoming(), docTipo)
          && incoming().criadoEm == request.time
          && incoming().atualizadoEm == request.time
          && (
            (equipe() && exists(/databases/$(database)/documents/cadastros/$(cadastroId)))
            || (
              existsAfter(/databases/$(database)/documents/cadastros/$(cadastroId))
              && getAfter(/databases/$(database)/documents/cadastros/$(cadastroId)).data.criadoEm == request.time
            )
          );

        allow update: if equipe()
          && isValidId(cadastroId)
          && docTipo in ['rg', 'cnh', 'certificado_mei']
          && isValidDocumentoAnexo(incoming(), docTipo)
          && exists(/databases/$(database)/documents/cadastros/$(cadastroId))
          && incoming().criadoEm == existing().criadoEm
          && incoming().atualizadoEm == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'nomeArquivo',
            'mimeType',
            'tamanhoBytes',
            'conteudoBase64',
            'atualizadoEm'
          ]);

        allow delete: if isAdmin()
          && isValidId(cadastroId)
          && docTipo in ['rg', 'cnh', 'certificado_mei'];
      }
    }

    // CHAVES DE UNICIDADE (anti-duplicidade de CPF/CNPJ sem exposição pública)
    match /cadastros_chaves/{chaveId} {
      allow get, list: if isAdmin();

      allow create: if isValidId(chaveId)
        && isValidCadastroChave(incoming(), chaveId)
        && incoming().criadoEm == request.time
        && (
          (isAdmin() && existsAfter(/databases/$(database)/documents/cadastros/$(incoming().cadastroId)))
          || (
            existsAfter(/databases/$(database)/documents/cadastros/$(incoming().cadastroId))
            && getAfter(/databases/$(database)/documents/cadastros/$(incoming().cadastroId)).data.criadoEm == request.time
            && (
              (incoming().tipo == 'cpf' && getAfter(/databases/$(database)/documents/cadastros/$(incoming().cadastroId)).data.cpfDigitos == incoming().valorDigitos)
              || (incoming().tipo == 'cnpj' && getAfter(/databases/$(database)/documents/cadastros/$(incoming().cadastroId)).data.cnpjDigitos == incoming().valorDigitos)
            )
          )
        );

      allow update: if false;
      allow delete: if isAdmin() && isValidId(chaveId);
    }

    // TERMOS DE DESCONTO GERADOS
    match /termos/{termoId} {
      allow get, list: if equipe();

      allow create: if equipe()
        && isValidId(termoId)
        && isValidTermo(incoming())
        && incoming().geradoPorUid == request.auth.uid
        && incoming().criadoEm == request.time
        && exists(/databases/$(database)/documents/cadastros/$(incoming().cadastroId));

      allow update: if false;
      allow delete: if isAdmin() && isValidId(termoId);
    }

    // AUDITORIA
    match /auditoria/{auditoriaId} {
      allow get, list: if isAdmin();

      allow create: if equipe()
        && isValidId(auditoriaId)
        && isValidAuditoria(incoming())
        && incoming().uid == request.auth.uid
        && incoming().criadoEm == request.time;

      allow update, delete: if false;
    }

    // USUÁRIOS DO PAINEL
    match /usuarios/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(uid)
        && isValidUsuario(incoming())
        && incoming().criadoEm == request.time
        && (!('atualizadoEm' in incoming()) || incoming().atualizadoEm == request.time);

      allow update: if isAdmin()
        && isValidId(uid)
        && isValidUsuario(incoming())
        && incoming().criadoEm == existing().criadoEm
        && (!('atualizadoEm' in incoming()) || incoming().atualizadoEm == request.time)
        && !(uid == request.auth.uid && (incoming().ativo == false || incoming().role != 'admin'))
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'nome',
          'email',
          'role',
          'ativo',
          'atualizadoEm'
        ]);

      allow delete: if isAdmin()
        && isValidId(uid)
        && uid != request.auth.uid;
    }
  }
}
